{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: nothing beyond what the app needs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-browser-cookies",
    "allow-browser-profiles",
    "allow-default-browser",
    "allow-http-fetch",
    "allow-update-support",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*.google.com/*"
        },
        {
          "url": "https://*.youtube.com/*"
        },
        {
          "url": "https://github.com/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
